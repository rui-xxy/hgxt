{
  "name": "hgxt",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @hgxt/api --filter @hgxt/admin dev",
    "dev:api": "pnpm --filter @hgxt/api dev",
    "dev:admin": "pnpm --filter @hgxt/admin dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @hgxt/api db:generate",
    "db:migrate": "pnpm --filter @hgxt/api db:migrate",
    "db:seed": "pnpm --filter @hgxt/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "typescript-eslint": "^8.70.1"
  }
}
