// HGXT 数据库模型。表单结构沿用已部署的 forms_module 迁移。
// 刻意不做 RBAC 五表、软删除、部门等，等真实业务出现再演进（见 docs/architecture.md）。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// Refresh Token 被作废的原因（审计用）
enum RevokedReason {
  ROTATED        // 正常轮换
  LOGOUT         // 主动登出
  PASSWORD_RESET // 密码重置
  USER_DISABLED  // 用户被禁用
  REUSE_DETECTED // 疑似泄露（超宽限期复用，连坐吊销）
}

model User {
  id            String         @id @default(uuid())
  username      String         @unique
  name          String
  email         String?        @unique
  phone         String?
  passwordHash  String
  role          Role           @default(USER)
  status        UserStatus     @default(ACTIVE)
  /// 会话版本：签进 JWT 的 ver。重置密码/强制下线时 +1，使全部旧 Access Token 立即失效
  authVersion   Int            @default(1)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  formSubmissions FormSubmission[]
}

/// Refresh Token 只存 sha256 哈希；轮换 = 旧的标记 revokedAt + revokedReason、写入新行。
model RefreshToken {
  id            String        @id @default(uuid())
  tokenHash     String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason RevokedReason?
  createdAt     DateTime      @default(now())

  @@index([userId])
}

model Form {
  id          String           @id @default(uuid())
  title       String
  /// 稳定业务标识（如 sulfuric_daily / sales_daily），代码用此字段找表
  code           String?          @unique
  category       String           @default("生产")
  /// form = 独立填写页；sheet = 仅在数据表格中维护
  entryMode      String           @default("form")
  description String?
  schema      Json
  status      String           @default("published")
  /// 是否启用「停车记录」附加录入（由表单定义决定，不按标题硬编码）
  parkingEnabled Boolean       @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  submissions FormSubmission[]

  @@index([status])
}

model FormSubmission {
  id          String   @id @default(uuid())
  formId      String
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  data        Json
  submitterId String?
  submitter   User?    @relation(fields: [submitterId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([formId, createdAt])
}
// 储罐与电表档案：产盘指标的换算参数（液位%→吨、读数差→度）
// fieldId 对应表单的字段 id；罐容为占位值，需按真实设备参数修正

model Tank {
  id       String  @id @default(uuid())
  fieldId  String  @unique
  name     String
  material String // 98酸 / 发烟硫酸 / 试剂酸 / 双氧水
  capacity Float // 罐容（m³）
  density  Float // 密度（t/m³）：98/93/试剂≈1.84，发烟≈1.92
  /// 归属表单 code（如 sulfuric_daily）——算硫酸只查硫酸的罐，其他车间的罐互不干扰
  formCode String @default("sulfuric_daily")
}

model Meter {
  id         String  @id @default(uuid())
  fieldId    String  @unique
  name       String
  multiplier Float   @default(1) // 倍率
  /// 归属表单 code
  formCode   String  @default("sulfuric_daily")
}

// 生产计划：年度计划与各月计划分别录入，months 的 null 表示未填写
// 计划与完成看板按 year+workshop 取计划，实际值全部从表单现算

model ProductionPlan {
  id        String   @id @default(uuid())
  year      Int
  /// 车间名：硫酸 / 氨基磺酸 / 硫酸镁 / 水滑石 / 二乙基蒽醌 / 丰联
  workshop  String
  /// 年度计划（t）
  annual    Float    @default(0)
  /// 12 个月的计划值：{"1": 8600, ...}，缺省/null = 未填写
  months    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, workshop])
}

// 单耗上限（对标与预警）：旧区间目标仅使用上限值

model ConsumptionTarget {
  id        String   @id @default(uuid())
  workshop  String
  /// 能源/原辅料名：电、蒸汽、水、尿素、氧化镁……
  material  String
  /// 单耗单位：kWh/t、t/t、m³/t、kg/t
  unit      String
  /// 上限数值文本；空字符串表示未设置
  target    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workshop, material])
}

// 设备维修日志：仅保存登记/Excel 主表原值，首页统计全部从这些记录实时计算。
// reportYear/reportMonth 是原表「统计月份」的归属期，不能从自然日期反推。
model MaintenanceRecord {
  id              String   @id @default(uuid())
  sourceWorkbook  String?
  sourceRow       Int?
  sourceDateText  String
  date            DateTime? @db.Date
  reportYear      Int
  reportMonth     Int
  personnel       String   @default("")
  department      String   @default("")
  location        String   @default("")
  equipmentModel  String   @default("")
  workContent     String   @default("")
  workTimeText    String   @default("")
  replacedParts   String   @default("")
  faultType       String   @default("")
  faultCause      String   @default("")
  repairHours     Float?
  isRework        Boolean  @default(false)
  remarks         String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([reportYear, reportMonth])
  @@index([date])
  @@index([department])
  @@unique([sourceWorkbook, sourceRow])
}
