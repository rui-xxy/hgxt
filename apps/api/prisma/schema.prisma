// HGXT 数据库模型。表单结构沿用已部署的 forms_module 迁移。
// 刻意不做 RBAC 五表、软删除、部门等，等真实业务出现再演进（见 docs/architecture.md）。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// Refresh Token 被作废的原因（审计用）
enum RevokedReason {
  ROTATED        // 正常轮换
  LOGOUT         // 主动登出
  PASSWORD_RESET // 密码重置
  USER_DISABLED  // 用户被禁用
  REUSE_DETECTED // 疑似泄露（超宽限期复用，连坐吊销）
}

model User {
  id            String         @id @default(uuid())
  username      String         @unique
  name          String
  email         String?        @unique
  phone         String?
  passwordHash  String
  role          Role           @default(USER)
  status        UserStatus     @default(ACTIVE)
  /// 会话版本：签进 JWT 的 ver。重置密码/强制下线时 +1，使全部旧 Access Token 立即失效
  authVersion   Int            @default(1)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  formSubmissions FormSubmission[]
}

/// Refresh Token 只存 sha256 哈希；轮换 = 旧的标记 revokedAt + revokedReason、写入新行。
model RefreshToken {
  id            String        @id @default(uuid())
  tokenHash     String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason RevokedReason?
  createdAt     DateTime      @default(now())

  @@index([userId])
}

model Form {
  id          String           @id @default(uuid())
  title       String
  description String?
  schema      Json
  status      String           @default("published")
  /// 是否启用「停车记录」附加录入（由表单定义决定，不按标题硬编码）
  parkingEnabled Boolean       @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  submissions FormSubmission[]

  @@index([status])
}

model FormSubmission {
  id          String   @id @default(uuid())
  formId      String
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  data        Json
  submitterId String?
  submitter   User?    @relation(fields: [submitterId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([formId, createdAt])
}
