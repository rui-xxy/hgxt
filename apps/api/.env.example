# PostgreSQL 连接串（开发：docker compose up -d 起的 postgres:18，仅监听 127.0.0.1:5433）
# 服务器部署时改指向本机 PostgreSQL，如：
#   postgresql://hgxt:密码@127.0.0.1:5432/hgxt?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/hgxt?schema=public"

# API 监听地址：开发默认只监听本机；服务器对外部署时显式改为 0.0.0.0
HOST=127.0.0.1
PORT=3001

# 部署在 nginx 等反向代理之后时设 1（采信 X-Forwarded-For，限流才按真实 IP 分桶）；
# API 直接对外提供服务时保持注释——开着会被伪造请求头绕过限流
# TRUST_PROXY=1

# JWT Access Token 签名密钥：至少 32 字符的随机串。
# 生产环境配置过弱（过短 / 示例值）会拒绝启动。生成：openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-to-a-long-random-secret"

# 仅生产环境需要：默认生产不挂 Swagger，需要时设 true
# ENABLE_SWAGGER=false

# 仅运行 seed 时需要：初始管理员密码（不设则 seed 拒绝执行，且不再有默认值）
# SEED_ADMIN_PASSWORD="Admin@123456"

# 服务器部署的完整步骤见 docs/deploy.md（NODE_ENV=production 由 systemd 单元注入，不写在这里）
