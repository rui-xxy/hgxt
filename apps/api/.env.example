# PostgreSQL 连接串（docker compose up -d 启动本项目的 postgres:18，仅监听 127.0.0.1:5433）
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/hgxt?schema=public"

# API 监听地址：开发默认只监听本机；对外部署时显式改为 0.0.0.0
HOST=127.0.0.1
PORT=3001

# JWT Access Token 签名密钥：至少 32 字符的随机串。
# 生产环境配置过弱（过短 / 示例值）会拒绝启动。
JWT_ACCESS_SECRET="change-me-to-a-long-random-secret"

# 仅生产环境需要：默认生产不挂 Swagger，需要时设 true
# ENABLE_SWAGGER=false

# 仅运行 seed 时需要：初始管理员密码（不设则 seed 拒绝执行，且不再有默认值）
# SEED_ADMIN_PASSWORD="Admin@123456"
